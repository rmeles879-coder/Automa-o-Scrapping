# Copie para .env e preencha localmente; nunca versione credenciais reais.
VIDEO_ENV=development
VIDEO_LOG_LEVEL=INFO
VIDEO_OUTPUT_DIR=output
VIDEO_CACHE_DIR=.cache/video-production
VIDEO_HTTP_TIMEOUT_SECONDS=30
VIDEO_USER_AGENT=Automa-o-Scrapping/0.2 (+https://github.com/rmeles879-coder/Automa-o-Scrapping)

# Necessárias apenas para o respectivo provider. Wikimedia não precisa de chave.
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
